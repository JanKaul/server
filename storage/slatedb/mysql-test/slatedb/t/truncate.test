--source include/have_slatedb.inc

--disable_warnings
DROP TABLE IF EXISTS t1;
--enable_warnings

CREATE TABLE t1 (pk INT NOT NULL PRIMARY KEY, a INT) ENGINE=slatedb;
INSERT INTO t1 VALUES (1, 10), (2, 20), (3, 30);
SELECT COUNT(*) FROM t1;

TRUNCATE TABLE t1;
SELECT COUNT(*) FROM t1;

# Data inserted after TRUNCATE is visible
INSERT INTO t1 VALUES (1, 100), (2, 200);
--sorted_result
SELECT * FROM t1;

DROP TABLE t1;
