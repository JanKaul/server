--source include/have_slatedb.inc

--disable_warnings
DROP TABLE IF EXISTS t1;
--enable_warnings

CREATE TABLE t1 (
  pk  INT NOT NULL PRIMARY KEY,
  i   INT NOT NULL,
  b   BIGINT NOT NULL,
  c   CHAR(8) NOT NULL,
  vc  VARBINARY(16) NOT NULL
) ENGINE=slatedb;

SHOW COLUMNS IN t1;

INSERT INTO t1 VALUES (1, 42, 9999, 'hello', 'world');
INSERT INTO t1 VALUES (2, 0, 0, '', '');
INSERT INTO t1 VALUES (3, -1, -9223372036854775808, 'x', 'y');

--sorted_result
SELECT * FROM t1;

# NOT NULL columns should reject NULLs (NO_ENGINE_SUBSTITUTION mode raises error)
--error ER_BAD_NULL_ERROR
INSERT INTO t1 VALUES (4, NULL, 0, 'z', 'z');

--sorted_result
SELECT * FROM t1;

DROP TABLE t1;
