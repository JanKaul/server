--source include/have_slatedb.inc

--disable_warnings
DROP TABLE IF EXISTS t1;
--enable_warnings

CREATE TABLE t1 (pk INT NOT NULL PRIMARY KEY, a INT, b CHAR(8)) ENGINE=slatedb;
SHOW CREATE TABLE t1;
SHOW COLUMNS IN t1;
INSERT INTO t1 VALUES (1, 1, 'a');
INSERT INTO t1 VALUES (2, 2, 'b');
--sorted_result
SELECT pk, a, b FROM t1;
DROP TABLE t1;
