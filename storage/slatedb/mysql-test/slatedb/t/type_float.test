--source include/have_slatedb.inc

--disable_warnings
DROP TABLE IF EXISTS t1;
--enable_warnings

CREATE TABLE t1 (
  pk  INT NOT NULL PRIMARY KEY,
  f   FLOAT,
  d   DOUBLE
) ENGINE=slatedb;

SHOW COLUMNS IN t1;

INSERT INTO t1 VALUES (1, 1.5, 3.14159265358979);
INSERT INTO t1 VALUES (2, -1.5, -2.718281828);
INSERT INTO t1 VALUES (3, 0.0, 0.0);
INSERT INTO t1 VALUES (4, NULL, NULL);

--sorted_result
SELECT * FROM t1;

DROP TABLE t1;
