--source include/have_slatedb.inc

--disable_warnings
DROP TABLE IF EXISTS t1;
--enable_warnings

CREATE TABLE t1 (pk INT NOT NULL PRIMARY KEY, a INT) ENGINE=slatedb;
INSERT INTO t1 VALUES (1, 10), (2, 20), (3, 30);

# Committed insert is visible
BEGIN;
INSERT INTO t1 VALUES (4, 40);
COMMIT;
--sorted_result
SELECT * FROM t1;

# Rolled-back insert is not visible
BEGIN;
INSERT INTO t1 VALUES (5, 50);
ROLLBACK;
--sorted_result
SELECT * FROM t1;

# Committed delete is visible
BEGIN;
DELETE FROM t1 WHERE pk = 1;
COMMIT;
--sorted_result
SELECT * FROM t1;

# Rolled-back delete is not visible
BEGIN;
DELETE FROM t1 WHERE pk = 2;
ROLLBACK;
--sorted_result
SELECT * FROM t1;

# Committed update is visible
BEGIN;
UPDATE t1 SET a = 99 WHERE pk = 2;
COMMIT;
--sorted_result
SELECT * FROM t1;

# Rolled-back update is not visible
BEGIN;
UPDATE t1 SET a = 0 WHERE pk = 3;
ROLLBACK;
--sorted_result
SELECT * FROM t1;

DROP TABLE t1;
