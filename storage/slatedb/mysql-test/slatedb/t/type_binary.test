--source include/have_slatedb.inc

--disable_warnings
DROP TABLE IF EXISTS t1;
--enable_warnings

CREATE TABLE t1 (
  pk  INT NOT NULL PRIMARY KEY,
  b4  BINARY(4),
  vb  VARBINARY(16)
) ENGINE=slatedb;

SHOW COLUMNS IN t1;

INSERT INTO t1 VALUES (1, 'abcd', 'hello');
INSERT INTO t1 VALUES (2, '', '');
INSERT INTO t1 VALUES (3, NULL, NULL);
INSERT INTO t1 VALUES (4, 'AB', 'world!!');

--sorted_result
SELECT pk, HEX(b4), HEX(vb) FROM t1;

DROP TABLE t1;
