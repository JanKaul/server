DROP TABLE IF EXISTS t1;
CREATE TABLE t1 (
pk  INT NOT NULL PRIMARY KEY,
b4  BINARY(4),
vb  VARBINARY(16)
) ENGINE=slatedb;
SHOW COLUMNS IN t1;
Field	Type	Null	Key	Default	Extra
pk	int(11)	NO	PRI	NULL	
b4	binary(4)	YES		NULL	
vb	varbinary(16)	YES		NULL	
INSERT INTO t1 VALUES (1, 'abcd', 'hello');
INSERT INTO t1 VALUES (2, '', '');
INSERT INTO t1 VALUES (3, NULL, NULL);
INSERT INTO t1 VALUES (4, 'AB', 'world!!');
SELECT pk, HEX(b4), HEX(vb) FROM t1;
pk	HEX(b4)	HEX(vb)
1	61626364	68656C6C6F
2	00000000	
3	NULL	NULL
4	41420000	776F726C642121
DROP TABLE t1;
