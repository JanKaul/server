DROP TABLE IF EXISTS t1;
CREATE TABLE t1 (pk INT NOT NULL PRIMARY KEY, a INT, b CHAR(8)) ENGINE=slatedb;
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `pk` int(11) NOT NULL,
  `a` int(11) DEFAULT NULL,
  `b` char(8) DEFAULT NULL,
  PRIMARY KEY (`pk`)
) ENGINE=SLATEDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_uca1400_ai_ci
SHOW COLUMNS IN t1;
Field	Type	Null	Key	Default	Extra
pk	int(11)	NO	PRI	NULL	
a	int(11)	YES		NULL	
b	char(8)	YES		NULL	
INSERT INTO t1 VALUES (1, 1, 'a');
INSERT INTO t1 VALUES (2, 2, 'b');
SELECT pk, a, b FROM t1;
pk	a	b
1	1	a
2	2	b
DROP TABLE t1;
