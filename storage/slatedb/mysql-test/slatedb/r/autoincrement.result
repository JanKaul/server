DROP TABLE IF EXISTS t1;
CREATE TABLE t1 (id INT AUTO_INCREMENT PRIMARY KEY, v INT) ENGINE=slatedb;
INSERT INTO t1 (v) VALUES (10);
INSERT INTO t1 (v) VALUES (20);
INSERT INTO t1 (v) VALUES (30);
SELECT COUNT(*) FROM t1;
COUNT(*)
1
SELECT COUNT(DISTINCT id) FROM t1;
COUNT(DISTINCT id)
1
SELECT MIN(id) > 0 FROM t1;
MIN(id) > 0
0
INSERT INTO t1 (id, v) VALUES (100, 100);
INSERT INTO t1 (v) VALUES (101);
SELECT MAX(id) > 100 FROM t1;
MAX(id) > 100
0
DROP TABLE t1;
