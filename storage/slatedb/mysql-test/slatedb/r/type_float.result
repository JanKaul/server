DROP TABLE IF EXISTS t1;
CREATE TABLE t1 (
pk  INT NOT NULL PRIMARY KEY,
f   FLOAT,
d   DOUBLE
) ENGINE=slatedb;
SHOW COLUMNS IN t1;
Field	Type	Null	Key	Default	Extra
pk	int(11)	NO	PRI	NULL	
f	float	YES		NULL	
d	double	YES		NULL	
INSERT INTO t1 VALUES (1, 1.5, 3.14159265358979);
INSERT INTO t1 VALUES (2, -1.5, -2.718281828);
INSERT INTO t1 VALUES (3, 0.0, 0.0);
INSERT INTO t1 VALUES (4, NULL, NULL);
SELECT * FROM t1;
pk	f	d
1	1.5	3.14159265358979
2	-1.5	-2.718281828
3	0	0
4	NULL	NULL
DROP TABLE t1;
