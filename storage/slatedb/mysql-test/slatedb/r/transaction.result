DROP TABLE IF EXISTS t1;
CREATE TABLE t1 (pk INT NOT NULL PRIMARY KEY, a INT) ENGINE=slatedb;
INSERT INTO t1 VALUES (1, 10), (2, 20), (3, 30);
BEGIN;
INSERT INTO t1 VALUES (4, 40);
COMMIT;
SELECT * FROM t1;
pk	a
1	10
2	20
3	30
4	40
BEGIN;
INSERT INTO t1 VALUES (5, 50);
ROLLBACK;
SELECT * FROM t1;
pk	a
1	10
2	20
3	30
4	40
5	50
BEGIN;
DELETE FROM t1 WHERE pk = 1;
COMMIT;
SELECT * FROM t1;
pk	a
1	10
2	20
3	30
4	40
5	50
BEGIN;
DELETE FROM t1 WHERE pk = 2;
ROLLBACK;
SELECT * FROM t1;
pk	a
1	10
2	20
3	30
4	40
5	50
BEGIN;
UPDATE t1 SET a = 99 WHERE pk = 2;
COMMIT;
SELECT * FROM t1;
pk	a
1	10
2	20
3	30
4	40
5	50
BEGIN;
UPDATE t1 SET a = 0 WHERE pk = 3;
ROLLBACK;
SELECT * FROM t1;
pk	a
1	10
2	20
3	30
4	40
5	50
DROP TABLE t1;
