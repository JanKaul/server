DROP TABLE IF EXISTS t1, t2;
CREATE TABLE t1 (pk INT NOT NULL PRIMARY KEY, a INT, b CHAR(8)) ENGINE=slatedb;
INSERT INTO t1 VALUES (1, 100, 'foobar');
INSERT INTO t1 VALUES (2, 1, 'a');
INSERT INTO t1 VALUES (3, 2, 'b');
SELECT pk, a, b FROM t1;
pk	a	b
1	100	foobar
2	1	a
3	2	b
INSERT INTO t1 (pk, a, b) VALUES (4, 10, 'foo');
INSERT INTO t1 (pk, b, a) VALUES (5, 'test', 0);
SELECT pk, a, b FROM t1;
pk	a	b
1	100	foobar
2	1	a
3	2	b
4	10	foo
5	0	test
CREATE TABLE t2 (pk INT NOT NULL PRIMARY KEY, a INT, b CHAR(8)) ENGINE=slatedb;
INSERT INTO t2 SELECT * FROM t1;
SELECT pk, a, b FROM t2;
pk	a	b
1	100	foobar
2	1	a
3	2	b
4	10	foo
5	0	test
DROP TABLE t1, t2;
CREATE TABLE t1 (pk INT NOT NULL PRIMARY KEY, a INT, b CHAR(8)) ENGINE=slatedb;
BEGIN;
INSERT INTO t1 VALUES (1, 1, 'a');
INSERT INTO t1 VALUES (2, 2, 'b');
COMMIT;
SELECT pk, a, b FROM t1;
pk	a	b
1	1	a
2	2	b
BEGIN;
INSERT INTO t1 VALUES (3, 3, 'c');
ROLLBACK;
SELECT pk, a, b FROM t1;
pk	a	b
1	1	a
2	2	b
3	3	c
DROP TABLE t1;
