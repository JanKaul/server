DROP TABLE IF EXISTS t1, t2, t3;
CREATE TABLE t1 (pk INT NOT NULL PRIMARY KEY, a INT) ENGINE=slatedb;
INSERT INTO t1 VALUES (1, 10), (2, 20), (100, 999);
SELECT * FROM t1;
pk	a
1	10
100	999
2	20
DROP TABLE t1;
CREATE TABLE t2 (pk BIGINT NOT NULL PRIMARY KEY, v INT) ENGINE=slatedb;
INSERT INTO t2 VALUES (9223372036854775807, 1), (-9223372036854775808, 2), (0, 3);
SELECT * FROM t2;
pk	v
-9223372036854775808	2
0	3
9223372036854775807	1
DROP TABLE t2;
CREATE TABLE t3 (id INT AUTO_INCREMENT PRIMARY KEY, v INT) ENGINE=slatedb;
INSERT INTO t3 (v) VALUES (10), (20), (30);
SELECT COUNT(*) FROM t3;
COUNT(*)
1
DROP TABLE t3;
