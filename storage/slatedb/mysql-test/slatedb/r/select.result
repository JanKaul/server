DROP TABLE IF EXISTS t1;
CREATE TABLE t1 (pk INT NOT NULL PRIMARY KEY, a INT, b CHAR(8)) ENGINE=slatedb;
INSERT INTO t1 VALUES (1, 100, 'foobar');
INSERT INTO t1 VALUES (2, 1, 'z');
INSERT INTO t1 VALUES (3, 200, 'bar');
SELECT * FROM t1;
pk	a	b
1	100	foobar
2	1	z
3	200	bar
SELECT pk, a FROM t1;
pk	a
1	100
2	1
3	200
SELECT DISTINCT a FROM t1;
a
1
100
200
SELECT COUNT(*) FROM t1;
COUNT(*)
3
SELECT MIN(a), MAX(a) FROM t1;
MIN(a)	MAX(a)
1	200
SELECT SUM(a) FROM t1;
SUM(a)
301
SELECT pk FROM t1 WHERE a IS NOT NULL;
pk
1
2
3
DROP TABLE t1;
